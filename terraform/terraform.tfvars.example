project          = "task-tracker"
aws_region       = "us-east-1"
instance_type    = "t3.micro"
# Restrict SSH and monitoring UIs to your IP:
# ssh_allowed_cidr = "203.0.113.42/32"
# To reuse an existing key pair, point at the .pub file (the matching private
# key must sit next to it, without the .pub suffix):
# public_key_path  = "~/.ssh/id_rsa.pub"
