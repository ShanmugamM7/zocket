project     = "zocket"
aws_region  = "ap-south-1"
aws_profile = "PERSONAL"

# Fargate sizing — matches rozana-oms-prod defaults scaled down for dev
task_cpu    = 512
task_memory = 1024

# Number of running tasks
desired_count = 1

# Optional: pin a specific image tag instead of :latest
# container_image = "123456789012.dkr.ecr.ap-south-1.amazonaws.com/zocket:v1.0.0"

# Optional: enable HTTPS by providing an ACM certificate ARN
# certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Optional: extra tags
# tags = { Env = "dev", Team = "platform" }
